# Publicación: dejar vacíos durante la vista previa
NEXT_PUBLIC_SITE_URL=
SITE_INDEXABLE=false
# Envío real SMTP. Las pruebas usan únicamente un servidor local efímero.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
# true solo detrás de un proxy confiable que sobrescriba X-Forwarded-For
TRUST_PROXY=false
# CRM / Supabase: usar la URI Transaction pooler del panel Connect (puerto 6543).
# Pegar la URI real solo en Vercel o .env.local, con TLS según Supabase.
# Ejecutar antes supabase/migrations/202610210001_crm.sql en SQL Editor.
# No hacen falta claves anon ni service_role: el CRM conecta solo desde el servidor.
DATABASE_URL=
# Solo para desarrollo local o un servidor con disco persistente
CRM_STORAGE=
CRM_SQLITE_PATH=.data/crm.sqlite
CRM_ADMIN_EMAIL=lemosmoralesadministracion@gmail.com
# Generar con scripts/setup-crm.mjs; no pegar la contraseña en este archivo
CRM_PASSWORD_HASH=
# Mínimo 32 caracteres aleatorios, independiente de la contraseña
CRM_SESSION_SECRET=
